    {
      "parameters": {
        "jsCode": "// 기준 이메일\nconst myEmail = \"riswelliswell@gmail.com\";\n\n// Google Sheets에서 가져온 모든 데이터\nconst allData = items;\n\n// 내 이메일이 있는 인덱스 찾기\nconst myIndex = allData.findIndex(item => item.json[\"option gmail\"] === myEmail);\n\n// 결과 담을 배열\nlet filteredEmails = [];\n\nif (myIndex !== -1) {\n  const sliceEnd = Math.min(myIndex + 4, allData.length); // 내 이메일 + 최대 3명\n  const selected = allData.slice(myIndex, sliceEnd);\n\n  // 이메일만 추출 + 빈 문자열 제거\n  filteredEmails = selected\n    .map(item => item.json[\"option gmail\"])\n    .filter(email => email && email.trim() !== \"\") // 빈 값 제거\n    .map(email => ({ json: { email } }));\n}\n\nreturn filteredEmails;\n\n"
      },
